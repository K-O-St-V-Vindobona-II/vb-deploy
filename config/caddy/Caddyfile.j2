{
	email {{ acme_email }}
{% if caddy_acme_ca is defined %}
	# Let's Encrypt's staging CA: unlimited issuance, but the certificate chain
	# is not publicly trusted. Only ever set on a non-production stage while
	# iterating, to stay under the production CA's per-name rate limit.
	acme_ca {{ caddy_acme_ca }}
{% endif %}
	# The admin API is unauthenticated and, with host networking, reachable by every
	# process on the host. Nothing needs it at runtime: configuration changes are
	# applied by restarting the unit and the health check uses the loopback
	# listener below.
	admin off
	# Disables HTTP/3 (QUIC) and uses only TCP-based protocols
	servers {
		protocols h1 h2
	}
}

# Loopback-only liveness endpoint for the container health check.
http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond "ok" 200
}

# Baseline for every public site: HSTS and no server banner. The upstream
# banner is removed per proxy with header_down.
(edge_baseline) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{# Where the application's images and media are loaded from. Production uses
   the object storage's own host (storage_public_origin in the inventory); the
   other stages serve their storage through this Caddy under storage_domain. #}
{% if storage_public_origin is defined %}
{% set storage_origin = storage_public_origin %}
{% else %}
{% set storage_origin = 'https://' ~ storage_domain %}
{% endif %}
# vb-intern hardening: browser headers plus a Content-Security-Policy scoped to
# what the app loads: its own bundle, the Google sign-in script, stylesheet and
# frame, the API origin, and images and media from the object storage only (the
# standesdb and archive files are fetched from presigned storage URLs).
(intern_hardening) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; connect-src 'self' https://{{ api_domain }} https://accounts.google.com; frame-src https://accounts.google.com; img-src 'self' data: {{ storage_origin }}; media-src 'self' {{ storage_origin }}; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}
}

# vb-www hardening: the same browser headers plus a Content-Security-Policy
# scoped to what the public site loads: its own script, stylesheet and fonts,
# the API for fetch(), the gallery images from presigned storage URLs (the
# object storage host only) and the three frames embedded on the page (video,
# calendar, map).
(www_hardening) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' {{ storage_origin }}; font-src 'self'; connect-src https://{{ api_domain }}; frame-src https://www.youtube-nocookie.com https://calendar.google.com https://www.openstreetmap.org; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
	}
}

{{ intern_domain }} {
	import edge_baseline
	import intern_hardening

	# Access log for the log-viewer paths only. Application traffic is skipped so
	# that query strings containing personal data never reach the edge log.
	@not_logging not path /logging*
	log_skip @not_logging
	log

	route /logging* {
{% if logging_allowed_cidrs | default([]) %}
		@logging_forbidden not remote_ip {{ logging_allowed_cidrs | join(' ') }}
		respond @logging_forbidden 403
{% endif %}
		basic_auth {
			{$LOGGING_USER} {$LOGGING_PASSWORD_HASH}
		}
		reverse_proxy /logging/dozzle* 127.0.0.1:8081
	}

	reverse_proxy 127.0.0.1:21001 {
		header_down -Server
	}
}

{{ api_domain }} {
	import edge_baseline

	# Hard upper bound for any request body. Larger uploads are rejected here,
	# before the application buffers them.
	request_body {
		max_size {{ api_max_request_body | default('25MB') }}
	}

	reverse_proxy 127.0.0.1:21000 {
		header_down -Server
	}
}

{{ www_domain }} {
	import edge_baseline
	import www_hardening

	reverse_proxy 127.0.0.1:21002 {
		header_down -Server
	}
}

{% if app_environment != 'production' %}
{{ storage_domain }} {
	import edge_baseline

	reverse_proxy 127.0.0.1:9000 {
		header_down -Server
	}
}
{% endif %}
