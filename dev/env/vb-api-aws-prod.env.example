# DE: Optional (siehe AddHost=-Zeile im Quadlet). Nur noetig, um
#     scripts/downsync_prod.py bzw. den automatischen downsync-Job lokal
#     gegen die echte Prod-AWS-S3 laufen zu lassen. Ohne diese Datei
#     verweigern sich beide mit einer klaren Fehlermeldung, der Container
#     startet trotzdem normal.
# EN: Optional (see the EnvironmentFile=- line in the quadlet). Only
#     needed to run scripts/downsync_prod.py or the automated downsync
#     job locally against real prod AWS S3. Without this file both refuse
#     to run with a clear error message; the container still starts fine.

AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_BUCKET=vindobona2-at
AWS_REGION=eu-central-1
