# DE: Laufzeit-Env-Datei fuer den lokalen vb-api-redis-Dev-Container
#     (EnvironmentFile=%h/.env/vb-api-redis.env im Quadlet). Nach
#     ~/.env/vb-api-redis.env kopieren; das Passwort muss mit dem
#     REDIS_URL-Wert in vb-api.env uebereinstimmen.
# EN: Runtime env file for the local vb-api-redis dev container
#     (EnvironmentFile=%h/.env/vb-api-redis.env in the quadlet). Copy to
#     ~/.env/vb-api-redis.env; the password must match the REDIS_URL value
#     in vb-api.env.

REDIS_PASSWORD=change-me-to-a-long-random-string
