# DE: Laufzeit-Env-Datei fuer den lokalen vb-api-valkey-Dev-Container
#     (EnvironmentFile=%h/.env/vb-api-valkey.env im Quadlet). Nach
#     ~/.env/vb-api-valkey.env kopieren; das Passwort muss mit dem
#     VALKEY_URL-Wert in vb-api.env uebereinstimmen.
# EN: Runtime env file for the local vb-api-valkey dev container
#     (EnvironmentFile=%h/.env/vb-api-valkey.env in the quadlet). Copy to
#     ~/.env/vb-api-valkey.env; the password must match the VALKEY_URL value
#     in vb-api.env.

VALKEY_PASSWORD=change-me-to-a-long-random-string
