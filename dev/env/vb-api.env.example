# =============================================================================
# DE: Laufzeit-Env-Datei fuer den lokalen vb-api-Dev-Container
#     (EnvironmentFile=%h/.env/vb-api.env im Quadlet). Volle Doku aller
#     Variablen: vb-api/.env.example. Nach ~/.env/vb-api.env kopieren und
#     mit echten Werten befuellen.
# EN: Runtime env file for the local vb-api dev container
#     (EnvironmentFile=%h/.env/vb-api.env in the quadlet). Full docs for
#     every variable: vb-api/.env.example. Copy to ~/.env/vb-api.env and
#     fill in real values.
# =============================================================================

APP_ENVIRONMENT=development
TZ=Europe/Vienna
CORS_ORIGINS=http://localhost:20001,http://127.0.0.1:20001
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgresql+psycopg2://vb:change-me@localhost:5432/vb

# Valkey: used by the ARQ background worker (queued mail-notification
# tasks, cron jobs) - see vb-api-valkey.env for the matching password.
# Still a redis:// URL - arq's client library speaks the Redis wire
# protocol, which Valkey (a wire-compatible fork) also implements.
VALKEY_URL=redis://:change-me@localhost:6379/0

SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
PASSWORD_MIN_LENGTH=8

# SMTP: point at a local test server (e.g. Mailpit) - see vb-api.pod's
# AddHost for reaching a host-machine service by name from the container.
SMTP_HOST=<your-mail-dev-domain>
SMTP_PORT=1025
SMTP_USER=null
SMTP_PASSWORD=null
SMTP_FROM_EMAIL=noreply@vindobona.at
SMTP_FROM_NAME=VB intern
FRONTEND_RESET_URL=http://localhost:20001/auth/reset-password

# GOOGLE_CLIENT_ID=

# DE: NUR fuer lokale Entwicklung - siehe vb-api/.env.example.
# EN: LOCAL DEVELOPMENT ONLY - see vb-api/.env.example.
# DEV_SUPERUSER_ID=67fffed9-732a-454d-8aad-06c717655117

# S3: points at the local MinIO dev container (see vb-minio.pod's AddHost).
S3_ENDPOINT_URL=http://<your-minio-dev-domain>:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=vindobona2-at
S3_PUBLIC_ENDPOINT_URL=http://<your-minio-dev-domain>:9000
S3_PRESIGNED_EXPIRY=900

S3_PATH_STANDESDB_IMAGES=standesdb/images
S3_PATH_STANDESDB_CACHE=standesdb/cache
S3_PATH_ARCHIVE_STORE=archive/store
S3_PATH_ARCHIVE_CACHE=archive/cache
S3_PATH_DB_BACKUPS=db-backups
S3_PATH_PUBLIC_GALLERY=public/gallery

BACKUP_ENABLED=false
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=29
