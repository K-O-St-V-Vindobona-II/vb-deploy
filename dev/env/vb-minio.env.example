# DE: EnvironmentFile fuer den lokalen vb-minio-Dev-Container (S3-Ersatz
#     fuer echtes AWS S3 in Dev).
# EN: EnvironmentFile for the local vb-minio dev container (S3 stand-in
#     for real AWS S3 in dev).

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BROWSER_REDIRECT_URL=http://<your-minio-dev-domain>:9001
MINIO_SERVER_URL=http://<your-minio-dev-domain>:9000
MINIO_API_CORS_ALLOW_ORIGIN=*
