[Unit]
Description=Valkey (Redis) for VB API (Dev)

[Container]
ContainerName=vb-api-redis
Pod=vb-api.pod
Image=docker.io/valkey/valkey:8
AutoUpdate=registry
EnvironmentFile=%h/.env/vb-api-redis.env
Exec=sh -c 'exec valkey-server --requirepass "$REDIS_PASSWORD" --appendonly no --save ""'
Volume=%h/data/vb-api/redis:/data:Z

HealthCmd=valkey-cli -a "$REDIS_PASSWORD" ping || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=60
