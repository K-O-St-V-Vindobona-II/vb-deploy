[Unit]
Description=Valkey for VB API (Dev)

[Container]
ContainerName=vb-api-valkey
Pod=vb-api.pod
Image=docker.io/valkey/valkey:8
AutoUpdate=registry
EnvironmentFile=%h/.env/vb-api-valkey.env
Exec=sh -c 'exec valkey-server --requirepass "$VALKEY_PASSWORD" --appendonly no --save ""'
Volume=%h/data/vb-api/valkey:/data:Z

# The image's root entrypoint needs its default capabilities, so only the
# privilege-escalation guard is added here.
NoNewPrivileges=true

# The password reaches valkey-cli through the environment, not the command line.
HealthCmd=REDISCLI_AUTH="$VALKEY_PASSWORD" valkey-cli ping || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=60
