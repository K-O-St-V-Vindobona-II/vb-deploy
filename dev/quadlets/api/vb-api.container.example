[Unit]
Description=VB API Backend (Dev)
After=vb-api-pg.service

[Container]
ContainerName=vb-api
Pod=vb-api.pod
Image=vb-api:dev
AutoUpdate=local

Volume=<path-to-vb-fastapi-vue>/vb-api:/app:Z
UserNS=keep-id
Environment=WATCHFILES_FORCE_POLLING=true
EnvironmentFile=%h/.env/vb-api.env
# Optional: AWS credentials for the non-prod downsync script/job. The
# leading "-" makes the file optional - its absence is not an error.
EnvironmentFile=-%h/.env/vb-api-aws-prod.env

HealthCmd=python3 -c 'import urllib.request; urllib.request.urlopen("http://localhost:8000/")'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
