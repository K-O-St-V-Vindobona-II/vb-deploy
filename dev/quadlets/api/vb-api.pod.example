[Unit]
Wants=vb-api-pg.service vb-api.service vb-api-valkey.service vb-api-worker.service
Before=vb-api-pg.service vb-api.service vb-api-valkey.service vb-api-worker.service

[Pod]
PodName=vb-api-pod
# Keep this bound to 127.0.0.1: the API trusts the forwarded client address of
# any peer (the start command in the vb-api Dockerfile), so only processes of
# your machine may be able to connect.
PublishPort=127.0.0.1:20000:8000
PublishPort=127.0.0.1:5432:5432
# host-gateway lets the container reach services running directly on your
# host machine (e.g. a local Mailpit/Garage instance) by hostname.
AddHost=<your-mail-dev-domain>:host-gateway
AddHost=<your-garage-dev-domain>:host-gateway
# Quadlet defaults pods to ExitPolicy=stop, which exits the pod cleanly once its
# last container disappears - exactly what auto-update does when it stops and
# recreates one container - so the pod would stay down. "continue" keeps the pod
# and its infra container alive so the recreated container can rejoin it. Set
# through PodmanArgs because the dedicated ExitPolicy= key only exists from
# Podman 5.6.
PodmanArgs=--exit-policy=continue

[Install]
WantedBy=default.target
