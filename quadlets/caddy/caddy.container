[Unit]
Description=Caddy Web Server
After=network-online.target

[Container]
Image=docker.io/library/caddy:2
AutoUpdate=registry
ContainerName=caddy
Network=host
DNS=8.8.8.8
DNS=1.1.1.1

EnvironmentFile=%h/.env/caddy.env

# --- SECURITY HARDENING ---
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
# CAP_NET_BIND_SERVICE for ports 80/443
AddCapability=CAP_NET_BIND_SERVICE

# Ephemeral directories in RAM
Mount=type=tmpfs,target=/tmp,tmpfs-mode=1777
Mount=type=tmpfs,target=/run,tmpfs-mode=1777

# --- VOLUMES ---
Volume=%E/vb/infrastructure/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,z
Volume=%h/.local/share/caddy/caddy_data:/data

# Internal config in a named volume
Volume=caddy-config.volume:/config

# --- HEALTHCHECK ---
Notify=healthy
HealthCmd=wget -q -O - http://127.0.0.1:2019/config/ >/dev/null || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=10

[Install]
WantedBy=default.target
