APP_ENVIRONMENT={{ app_environment }}
CORS_ORIGINS=https://{{ intern_domain }},https://{{ www_domain }}
FRONTEND_RESET_URL=https://{{ intern_domain }}/auth/reset-password
# S3_PUBLIC_ENDPOINT_URL is what presigned URLs use, since those are fetched
# directly by end-user browsers, which cannot reach 127.0.0.1 on this host.
S3_PUBLIC_ENDPOINT_URL=https://{{ storage_domain }}

{% raw %}
# Everything up to the closing raw tag is copied literally, so a secret may
# contain braces (double curly or curly-percent sequences) without breaking the
# rendering. Do not quote values: the container runtime passes quotes through
# as part of the value.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Server-side minimum length of a new password. Must equal PASSWORD_MIN_LENGTH
# in vb-intern.env.j2, which only drives the hint shown in the form.
PASSWORD_MIN_LENGTH=12

DATABASE_URL=postgresql+psycopg2://vb:change-me@localhost:5432/vb

VALKEY_URL=redis://:change-me@localhost:6379/0

# This stage's own storage: the per-stage Garage instance vb-deploy sets up
# for every non-production stage (see README: Garage on Non-Production
# Stages) - not real AWS S3. Server-side traffic goes over loopback;
# the public address for presigned URLs is set at the top of this file.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=vindobona2-at
S3_REGION=us-east-1

S3_PATH_STANDESDB_IMAGES=standesdb/images
S3_PATH_STANDESDB_CACHE=standesdb/cache
S3_PATH_ARCHIVE_STORE=archive/store
S3_PATH_ARCHIVE_CACHE=archive/cache
S3_PATH_DB_BACKUPS=db-backups

# Read-only IAM user scoped to the production bucket only - used
# exclusively by the non-prod downsync job/button to mirror prod's S3
# data down onto this stage (app/services/downsync_service.py). Not the
# same credential as S3_ACCESS_KEY/S3_SECRET_KEY above, which target this
# stage's own bucket. Not needed on production.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_BUCKET=vindobona2-at
AWS_REGION=eu-central-1

# The backup job runs daily at BACKUP_HOUR and keeps BACKUP_RETENTION_DAYS days.
BACKUP_ENABLED=true
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=90

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=noreply@vindobona2.at
SMTP_FROM_NAME=K.Oe.St.V. Vindobona II

GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com

# Account and fee wording of the Aktivitas on the payment page; the
# Altherrenschaft half comes from the database. IBAN (spaces allowed) and BIC
# must be real, well-formed values: the API refuses to start with a malformed
# one, and the deployment refuses a file that still holds change-me.
AKTIVITAS_ACCOUNT_HOLDER=K.Ö.St.V. Vindobona II
AKTIVITAS_IBAN=change-me
AKTIVITAS_BIC=change-me
AKTIVITAS_FEE_TEXT=Der Aktivenbeitrag beläuft sich auf EUR 30,- / Semester
{% endraw %}
