[Unit]
Description=Valkey for VB API ({{ app_environment }})

[Container]
ContainerName=vb-api-valkey
Pod=vb-api.pod
Image=docker.io/valkey/valkey:8
AutoUpdate=registry
EnvironmentFile=%h/.env/vb-api-valkey.env
Exec=sh -c 'exec valkey-server --requirepass "$VALKEY_PASSWORD" --appendonly no --save ""'
Volume=%h/data/vb/{{ app_environment }}/valkey:/data:Z

# --- SECURITY HARDENING ---
# Same reasoning as vb-api-pg.container.j2: the playbook pre-chowns /data
# to UID 999 (see "Ensure Valkey data directory ownership" in deploy.yml),
# the official entrypoint only chowns its working directory and re-execs
# via setpriv when run as root - started directly as UID 999, it skips
# both, so no capabilities need to be added back.
User=999
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

# --- RESOURCE LIMITS ---
# Ceilings that contain a runaway process instead of letting it starve the
# other services of this host; they are not reservations.
PidsLimit=128
PodmanArgs=--memory=256m

Mount=type=tmpfs,target=/tmp,tmpfs-mode=1777,tmpfs-size=16m

# The password reaches valkey-cli through the environment, not the command
# line (a command-line argument is visible in the container's process list
# for the duration of every check). Startup counts as complete only once
# the health check passes, so that podman auto-update can detect a broken
# image and roll back.
Notify=healthy
HealthCmd=REDISCLI_AUTH="$VALKEY_PASSWORD" valkey-cli ping || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=60
