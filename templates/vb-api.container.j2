[Unit]
Description=VB API Backend ({{ app_environment }})
After=vb-api-pg.service

[Container]
ContainerName=vb-api
Pod=vb-api.pod
Image=ghcr.io/k-o-st-v-vindobona-ii/vb-api:latest
AutoUpdate=registry
EnvironmentFile=%h/.env/vb-api.env
{% if app_environment != 'production' %}
# Optional: AWS credentials for the non-prod downsync job/script. The
# leading "-" makes the file optional - its absence is not an error.
# Intentionally omitted on production: build_prod_storage() refuses to
# run there regardless, but this way the real prod AWS keys never even
# enter the production backend's environment in the first place.
EnvironmentFile=-%h/.env/vb-api-aws-prod.env
{% endif %}

HealthCmd=python3 -c 'import urllib.request; urllib.request.urlopen("http://localhost:8000/")'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
