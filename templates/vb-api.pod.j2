[Unit]
Wants=vb-api-pg.service vb-api.service vb-api-redis.service
Before=vb-api-pg.service vb-api.service vb-api-redis.service
{% if app_environment != 'production' %}
# MinIO joins this pod (not its own) so vb-api reaches it via the shared
# pod network namespace (localhost) - a separate pod is only reachable
# from another pod via Caddy/the public domain (every pod gets its own
# private loopback under pasta), and internal vb-api<->MinIO traffic must
# stay inside the pod network, never round-trip through the public
# internet.
Wants=vb-minio.service
Before=vb-minio.service
{% endif %}

[Pod]
PodName=vb-api-pod
AddHost={{ www_domain }}:host-gateway
PublishPort=127.0.0.1:21000:8000
{% if app_environment != 'production' %}
PublishPort=127.0.0.1:9000:9000
PublishPort=127.0.0.1:9001:9001
{% endif %}
# IPv4-only: pasta's default dual-stack IPv6 passthrough is fragile in this
# host's network setup and can silently black-hole outbound IPv6 connections
# (e.g. to Google's cert endpoint during Google Login) without ever erroring
# or timing out on its own. Nothing in this stack needs outbound IPv6.
Network=pasta:-4

[Install]
WantedBy=default.target
