[Unit]
Description=VB intern Frontend ({{ app_environment }})

[Container]
ContainerName=vb-intern
Pod=vb-intern.pod
Image=ghcr.io/k-o-st-v-vindobona-ii/vb-intern:latest
AutoUpdate=registry
EnvironmentFile=%h/.env/vb-intern.env

HealthCmd=wget -qO- http://127.0.0.1/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=60
